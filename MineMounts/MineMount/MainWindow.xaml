<Window x:Class="MineMount.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MineMount"
        xmlns:vm="clr-namespace:MineMount.ViewModels"
        xmlns:views="clr-namespace:MineMount.Views"
        mc:Ignorable="d"
        Title="MineMount"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontFamilyPrimary}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}">
            <views:GamesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}">
            <views:ServersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SeriesViewModel}">
            <views:SeriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SeriesDetailViewModel}">
            <views:SeriesDetailView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource BackgroundPrimaryBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderPrimaryBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="0"
                    Background="{StaticResource BackgroundSecondaryBrush}"
                    CornerRadius="12,0,0,12"
                    BorderBrush="{StaticResource BorderPrimaryBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="24,24,24,32">
                        <ContentControl Content="{StaticResource IconLogo}"
                                        Width="32" Height="32"
                                        VerticalAlignment="Center" />
                        <TextBlock Text="MINEMOUNT"
                                   Style="{StaticResource TextBlock.Logo}"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="1" Margin="12,0">
                        <Button Content="Inicio"
                                Command="{Binding NavigateHomeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Nav}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTag}" Value="Home">
                                            <Setter Property="local:NavHelper.Selected" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource IconHome}"
                                                        Width="20" Height="20"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding}"
                                                   Margin="12,0,0,0"
                                                   FontSize="14"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <Button Content="Series"
                                Command="{Binding NavigateSeriesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Nav}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTag}" Value="Series">
                                            <Setter Property="local:NavHelper.Selected" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource IconSeries}"
                                                        Width="20" Height="20"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding}"
                                                   Margin="12,0,0,0"
                                                   FontSize="14"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <Button Content="Configuración"
                                Command="{Binding NavigateSettingsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Nav}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavTag}" Value="Settings">
                                            <Setter Property="local:NavHelper.Selected" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Content="{StaticResource IconSettings}"
                                                        Width="20" Height="20"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding}"
                                                   Margin="12,0,0,0"
                                                   FontSize="14"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>

                    <!-- User Info -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BackgroundTertiaryBrush}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="12,0,12,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Background="{StaticResource AccentPrimaryBrush}">
                                <TextBlock Text="{Binding UserName, Converter={StaticResource FirstLetterConverter}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <TextBlock Text="{Binding UserName}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusText}"
                                           Style="{StaticResource TextBlock.Muted}"
                                           FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        Height="48"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="24,0,0,0">
                            <TextBlock Text="{Binding WindowTitle}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource ForegroundMutedBrush}" />
                            <Border VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Background="{StaticResource BackgroundTertiaryBrush}"
                                    CornerRadius="9999"
                                    Padding="9,3">
                                <TextBlock Text="{Binding Version}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ForegroundSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Command="{Binding MinimizeCommand}"
                                    Content="{StaticResource IconMinimize}"
                                    AutomationProperties.Name="Minimizar"
                                    ToolTip="Minimizar">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}" />
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="1"
                                    Command="{Binding MaximizeRestoreCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                                        <Setter Property="Content" Value="{StaticResource IconMaximize}" />
                                        <Setter Property="ToolTip" Value="Maximizar" />
                                        <Setter Property="AutomationProperties.Name" Value="Maximizar" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                                <Setter Property="Content" Value="{StaticResource IconRestore}" />
                                                <Setter Property="ToolTip" Value="Restaurar" />
                                                <Setter Property="AutomationProperties.Name" Value="Restaurar" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding CloseCommand}"
                                    Content="{StaticResource IconClose}"
                                    AutomationProperties.Name="Cerrar"
                                    ToolTip="Cerrar">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WindowCloseButton}" />
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <ContentControl x:Name="PageHost"
                                Grid.Row="1"
                                Content="{Binding CurrentPageViewModel}" />
            </Grid>
        </Grid>
    </Border>
</Window>
