<Window x:Class="MineMount.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MineMount"
        xmlns:vm="clr-namespace:MineMount.ViewModels"
        xmlns:views="clr-namespace:MineMount.Views"
        mc:Ignorable="d"
        Title="MineMount"
        Height="760" Width="1280"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="{StaticResource FontFamilyPrimary}">

    <!-- Bordes arrastrables en todos los lados (la barra de título se arrastra por código) -->
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8"
                      CaptionHeight="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}">
            <views:GamesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}">
            <views:ServersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SeriesViewModel}">
            <views:SeriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SeriesDetailViewModel}">
            <views:SeriesDetailView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource BaseBackgroundBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1">
        <Grid>
            <!-- Fondo inmersivo a pantalla completa (offline, con fallback sólido) -->
            <views:AnimatedBackground x:Name="Backdrop" />

            <!-- Partículas sutiles (desactivables) -->
            <views:ParticlesCanvas x:Name="ParticlesHost"
                                   Visibility="{Binding ParticlesActive, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ SIDEBAR translúcida ============ -->
                <Border x:Name="SidebarBorder"
                        Grid.Column="0"
                        Background="{DynamicResource GlassSidebarBrush}"
                        CornerRadius="12,0,0,12"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Margin="20,22,16,28">
                            <ContentControl Content="{StaticResource IconLogo}"
                                            Width="30" Height="30"
                                            VerticalAlignment="Center" />
                            <TextBlock Text="MINEMOUNT"
                                       Style="{StaticResource TextBlock.Logo}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#CC000000" Opacity="0.7" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <!-- Navegación -->
                        <StackPanel Grid.Row="1" Margin="10,0">
                            <Button Content="{DynamicResource S.Nav.Home}"
                                    Command="{Binding NavigateHomeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Nav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNavTag}" Value="Home">
                                                <Setter Property="local:NavHelper.Selected" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource IconHome}"
                                                            Width="20" Height="20"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{Binding}"
                                                       Margin="12,0,0,0"
                                                       FontSize="14"
                                                       FontWeight="Medium" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>

                            <Button Content="{DynamicResource S.Nav.Series}"
                                    Command="{Binding NavigateSeriesCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Nav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNavTag}" Value="Series">
                                                <Setter Property="local:NavHelper.Selected" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource IconSeries}"
                                                            Width="20" Height="20"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{Binding}"
                                                       Margin="12,0,0,0"
                                                       FontSize="14"
                                                       FontWeight="Medium" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>

                            <Button Content="{DynamicResource S.Nav.Settings}"
                                    Command="{Binding NavigateSettingsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Nav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNavTag}" Value="Settings">
                                                <Setter Property="local:NavHelper.Selected" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Content="{StaticResource IconSettings}"
                                                            Width="20" Height="20"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Text="{Binding}"
                                                       Margin="12,0,0,0"
                                                       FontSize="14"
                                                       FontWeight="Medium" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>

                        <!-- Perfil con skin de Minecraft -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10"
                                Margin="10,0,10,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="38" Height="38">
                                    <!-- Fallback: inicial -->
                                    <Border CornerRadius="19"
                                            Background="{DynamicResource PlayGradientBrush}">
                                        <TextBlock Text="{Binding UserName, Converter={StaticResource FirstLetterConverter}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Foreground="White" />
                                    </Border>
                                    <!-- Skin (cabeza 3D vía Minotar; si falla, se ve la inicial) -->
                                    <Border CornerRadius="19" ClipToBounds="True">
                                        <Image Source="{Binding AvatarUrl}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                    <TextBlock Text="{Binding UserName}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{DynamicResource CyanPrimaryBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Style="{StaticResource TextBlock.Muted}"
                                                   FontSize="10"
                                                   Margin="6,0,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ CONTENIDO ============ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Barra de título -->
                    <Border Grid.Row="0"
                            Background="Transparent"
                            Height="48"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="24,0,0,0">
                                <TextBlock x:Name="TitleText"
                                           Text="{Binding WindowTitle}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           MaxWidth="220"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ForegroundMutedBrush}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#CC000000" Opacity="0.8" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock x:Name="TitleVersionText"
                                           Text="{Binding Version, StringFormat=v{0}}"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="10,0,0,0"
                                           Foreground="{DynamicResource ForegroundMutedBrush}" />
                            </StackPanel>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="{DynamicResource S.Common.UpdateNow}"
                                        Command="{Binding UpdateNowCommand}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Padding="14,5"
                                        FontSize="10"
                                        FontWeight="SemiBold">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasUpdates}" Value="True" />
                                                        <Condition Binding="{Binding IsDownloading}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding UpdateProgress, Mode=OneWay}"
                                                 Width="160"
                                                 Height="6"
                                                 Style="{StaticResource ProgressBar.Glow}" />
                                    <TextBlock Text="{Binding UpdateStatus}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding MinimizeCommand}"
                                        Content="{StaticResource IconMinimize}"
                                        AutomationProperties.Name="{DynamicResource S.Common.Minimize}" ToolTip="{DynamicResource S.Common.Minimize}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}" />
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="1"
                                        Command="{Binding MaximizeRestoreCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                                            <Setter Property="Content" Value="{StaticResource IconMaximize}" />
                                            <Setter Property="ToolTip" Value="{DynamicResource S.Common.Maximize}" />
                                            <Setter Property="AutomationProperties.Name" Value="{DynamicResource S.Common.Maximize}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMaximized}" Value="True">
                                                    <Setter Property="Content" Value="{StaticResource IconRestore}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource S.Common.Restore}" />
                                                    <Setter Property="AutomationProperties.Name" Value="{DynamicResource S.Common.Restore}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding CloseCommand}"
                                        Content="{StaticResource IconClose}"
                                        AutomationProperties.Name="{DynamicResource S.Common.CloseApp}" ToolTip="{DynamicResource S.Common.CloseApp}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource WindowCloseButton}" />
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Página actual (fade + slide de 12px al cambiar) -->
                    <ContentControl x:Name="PageHost"
                                    Grid.Row="1"
                                    Content="{Binding CurrentPageViewModel}"
                                    ClipToBounds="True">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="PageSlide" X="0" Y="0" />
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!-- ============ BARRA INFERIOR fija (única acción de jugar) ============ -->
                    <Border x:Name="PlayBar"
                            Grid.Row="2"
                            Padding="24,16"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#BF0C0C12" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#14FFFFFF" />
                        </Border.BorderBrush>
                        <Border.BorderThickness>0,1,0,0</Border.BorderThickness>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavTag}" Value="Settings">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- JUGAR enorme + estado debajo (único botón de jugar) -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Button Command="{Binding PlayPrimaryCommand}"
                                        IsEnabled="{Binding CanPlayPrimary}"
                                        Tag="{Binding EnableAnimations}"
                                        Width="220" Height="56"
                                        AutomationProperties.Name="Jugar">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Play}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlayHasError}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerGradientBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGradientBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ContentControl Content="{StaticResource IconPlaySolid}"
                                                        Width="26" Height="26"
                                                        VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PlayButtonText}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   FontFamily="{StaticResource FontFamilyDisplay}"
                                                   FontWeight="Bold"
                                                   FontSize="22"
                                                   Foreground="White" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding PlayStatusDetail}"
                                           Margin="2,8,0,0"
                                           MaxWidth="320"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlock.Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlayStatusIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Setter Property="MaxWidth" Value="320" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#CC000000" Opacity="0.8" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>

                            <!-- Selector de serie / versión (se compacta en ventanas angostas) -->
                            <StackPanel x:Name="VersionPanel"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,26">
                                <TextBlock x:Name="VersionLabel"
                                           Text="SERIE"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           Margin="2,0,0,4" />
                                <ComboBox x:Name="VersionBox"
                                          ItemsSource="{Binding AvailableSeries}"
                                          SelectedItem="{Binding SelectedPlaySeries, Mode=TwoWay}"
                                          Width="220"
                                          Style="{StaticResource ComboBox.Base}"
                                          AutomationProperties.Name="Serie y versión">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource S.Serie}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Definition.MinecraftVersion, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Definition.Loader, Mode=OneWay}" />
                                                    <Run Text=" · v" />
                                                    <Run Text="{Binding Version, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Progreso de descarga / instalación -->
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Margin="20,0"
                                        Visibility="{Binding IsPlayBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding PlayProgress, Mode=OneWay}"
                                             Height="8"
                                             Style="{StaticResource ProgressBar.Glow}" />
                                <TextBlock Text="{Binding PlayProgressText}"
                                           Style="{StaticResource TextBlock.Caption}"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Promos a la derecha (máx. 2; se ocultan en ventanas angostas) -->
                            <ScrollViewer x:Name="PromoScroller"
                                          Grid.Column="3"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PromoItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PromoCard}"
                                                    Margin="0,0,8,0"
                                                    ToolTip="{Binding Description}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.PromoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Target}" />
                                                </Border.InputBindings>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ContentControl Content="{Binding IconKey, Converter={StaticResource PromoIconConverter}}"
                                                                    Width="22" Height="22"
                                                                    VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="#FFF3F4F6"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding DataContext.PromosCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Notificaciones -->
            <views:NotificationHost DataContext="{Binding Notifications}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,24,120"
                                    Width="340" />
        </Grid>
    </Border>
</Window>
