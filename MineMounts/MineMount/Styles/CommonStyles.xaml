<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Font Families -->
    <FontFamily x:Key="FontFamilyPrimary">Segoe UI Variable, Segoe UI, system-ui</FontFamily>
    <FontFamily x:Key="FontFamilyMonospace">Cascadia Code, Consolas, monospace</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI, system-ui</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSizeXS">11</sys:Double>
    <sys:Double x:Key="FontSizeSM">12</sys:Double>
    <sys:Double x:Key="FontSizeMD">14</sys:Double>
    <sys:Double x:Key="FontSizeLG">16</sys:Double>
    <sys:Double x:Key="FontSizeXL">20</sys:Double>
    <sys:Double x:Key="FontSize2XL">28</sys:Double>
    <sys:Double x:Key="FontSize3XL">36</sys:Double>
    <sys:Double x:Key="FontSize4XL">48</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">72</sys:Double>

    <!-- Font Weights -->
    <FontWeight x:Key="FontWeightLight">300</FontWeight>
    <FontWeight x:Key="FontWeightNormal">400</FontWeight>
    <FontWeight x:Key="FontWeightMedium">500</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">600</FontWeight>
    <FontWeight x:Key="FontWeightBold">700</FontWeight>

    <!-- Spacing -->
    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingSM">8</Thickness>
    <Thickness x:Key="SpacingMD">16</Thickness>
    <Thickness x:Key="SpacingLG">24</Thickness>
    <Thickness x:Key="SpacingXL">32</Thickness>
    <Thickness x:Key="Spacing2XL">48</Thickness>

    <!-- Border Radius -->
    <CornerRadius x:Key="BorderRadiusSM">4</CornerRadius>
    <CornerRadius x:Key="BorderRadiusMD">8</CornerRadius>
    <CornerRadius x:Key="BorderRadiusLG">12</CornerRadius>
    <CornerRadius x:Key="BorderRadiusXL">16</CornerRadius>
    <CornerRadius x:Key="BorderRadiusFull">9999</CornerRadius>

    <!-- Shadows -->
    <DropShadowEffect x:Key="ShadowSM" BlurRadius="4" ShadowDepth="1" Color="#FF000000" Opacity="0.3" Direction="270" />
    <DropShadowEffect x:Key="ShadowMD" BlurRadius="12" ShadowDepth="4" Color="#FF000000" Opacity="0.4" Direction="270" />
    <DropShadowEffect x:Key="ShadowLG" BlurRadius="24" ShadowDepth="8" Color="#FF000000" Opacity="0.5" Direction="270" />
    <DropShadowEffect x:Key="ShadowGlow" BlurRadius="20" ShadowDepth="0" Color="#FFE53935" Opacity="0.4" />

    <!-- Text Styles -->
    <Style x:Key="TextBlock.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextBlock.Primary" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
    </Style>

    <Style x:Key="TextBlock.Secondary" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
    </Style>

    <Style x:Key="TextBlock.Muted" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
    </Style>

    <Style x:Key="TextBlock.Accent" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
    </Style>

    <Style x:Key="TextBlock.Title" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize2XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
    </Style>

    <Style x:Key="TextBlock.Heading" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
    </Style>

    <Style x:Key="TextBlock.Subheading" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundSecondaryBrush}" />
    </Style>

    <Style x:Key="TextBlock.Display" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightLight}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
    </Style>

    <Style x:Key="TextBlock.Logo" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize3XL}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
    </Style>

    <Style x:Key="TextBlock.Caption" BasedOn="{StaticResource TextBlock.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXS}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundMutedBrush}" />
    </Style>

    <!-- Base Control Styles -->
    <Style x:Key="Control.Base" TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMD}" />
        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource SpacingSM}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- Animation Durations -->
    <Duration x:Key="DurationFast">0:0:0.1</Duration>
    <Duration x:Key="DurationNormal">0:0:0.2</Duration>
    <Duration x:Key="DurationSlow">0:0:0.3</Duration>
    <Duration x:Key="DurationVerySlow">0:0:0.5</Duration>

    <!-- Easing Functions -->
    <CubicEase x:Key="EaseStandard" EasingMode="EaseOut" />
    <QuadraticEase x:Key="EaseAccelerate" EasingMode="EaseIn" />
    <QuadraticEase x:Key="EaseDecelerate" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseSharp" EasingMode="EaseInOut" />

</ResourceDictionary>
