<UserControl x:Class="MineMount.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="NewsItemCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundTertiaryBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="320" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero: identidad MineMount -->
        <Border Grid.Row="0"
                Height="150"
                Margin="24,24,24,16"
                CornerRadius="12"
                BorderBrush="{StaticResource BorderPrimaryBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1A1230" Offset="0" />
                    <GradientStop Color="#FF241040" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Glow sutil -->
                <Ellipse Width="360" Height="360"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="180,60,-120,-180"
                         Fill="{StaticResource GlowGradientBrush}"
                         Opacity="0.4" />

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="32,0,16,0">
                    <TextBlock Text="{Binding BannerText}"
                               FontSize="40"
                               FontWeight="Bold"
                               FontFamily="{StaticResource FontFamilyDisplay}"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding BannerSubtitle}"
                               FontSize="15"
                               Foreground="{StaticResource ForegroundSecondaryBrush}"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Logo (placeholder: reemplazar Assets/Images/placeholder-logo.png) -->
                <Border Grid.Column="1"
                        Width="96"
                        Height="96"
                        Margin="32,0"
                        CornerRadius="20"
                        ClipToBounds="True"
                        Background="{StaticResource AccentTintBrush}"
                        BorderBrush="{StaticResource AccentPrimaryBrush}"
                        BorderThickness="1.5">
                    <Image Source="/MineMount;component/Assets/Images/placeholder-logo.png"
                           Stretch="UniformToFill" />
                </Border>
            </Grid>
        </Border>

        <!-- Noticias destacadas -->
        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="ÚLTIMAS NOVEDADES"
                           Style="{StaticResource TextBlock.Heading}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ProgressBar Width="80" Height="4" IsIndeterminate="True"
                                 Margin="0,0,12,0"
                                 Visibility="{Binding IsLoadingNews, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Command="{Binding RefreshNewsCommand}"
                            ToolTip="Actualizar noticias"
                            AutomationProperties.Name="Actualizar noticias">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                <Setter Property="Padding" Value="6" />
                            </Style>
                        </Button.Style>
                        <ContentControl Content="{StaticResource IconRefresh}"
                                        Width="16" Height="16"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Estado vacío -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,40,0,0"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNews}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No hay noticias por ahora"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Pulsa el botón de actualizar para reintentar"
                                   Style="{StaticResource TextBlock.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding NewsItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource NewsItemCard}">
                                    <StackPanel>

                                        <!-- Imagen de la noticia (si existe) -->
                                        <Border Height="120"
                                                CornerRadius="6"
                                                ClipToBounds="True"
                                                Margin="0,0,0,10"
                                                Background="{StaticResource BackgroundSecondaryBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding ImageUrl}"
                                                   Stretch="UniformToFill" />
                                        </Border>

                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource TextBlock.Muted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,10,0,0">
                                            <Border Background="{StaticResource AccentTintBrush}"
                                                    CornerRadius="9999"
                                                    Padding="8,3">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentLightBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                                       Style="{StaticResource TextBlock.Caption}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
