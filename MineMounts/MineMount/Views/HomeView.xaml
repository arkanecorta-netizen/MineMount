<UserControl x:Class="MineMount.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080">

    <UserControl.Triggers>
        <!-- Entrada escalonada: fade + slide de 12px -->
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeroPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="HeroSlide"
                                     Storyboard.TargetProperty="Y"
                                     From="12" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="FeaturedPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"
                                     BeginTime="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="FeaturedSlide"
                                     Storyboard.TargetProperty="Y"
                                     From="12" To="0" Duration="0:0:0.3"
                                     BeginTime="0:0:0.06">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="NewsPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"
                                     BeginTime="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="NewsSlide"
                                     Storyboard.TargetProperty="Y"
                                     From="12" To="0" Duration="0:0:0.3"
                                     BeginTime="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <!-- Tarjeta de noticia del carrusel: vidrio, hover eleva + borde morado + zoom -->
        <Style x:Key="NewsCarouselCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Width" Value="264" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Effect" Value="{StaticResource ShadowMD}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                    <Setter Property="Effect" Value="{StaticResource ShadowGlow}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TagPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,16,28,24" MaxWidth="1180">

            <!-- ================= HERO tipográfico sobre el fondo ================= -->
            <Grid x:Name="HeroPanel" Margin="0,8,0,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HeroSlide" X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" MaxWidth="640" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeroEyebrow}"
                               Style="{StaticResource TextBlock.HeroEyebrow}" />
                    <TextBlock Text="{Binding BannerTitle}"
                               Style="{StaticResource TextBlock.Hero}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding BannerSubtitle}"
                               FontSize="15"
                               Foreground="{StaticResource ForegroundSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="48"
                               Margin="0,10,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#CC000000" Opacity="0.8" Direction="270" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Línea serie · versión · loader (datos reales) -->
                    <Border Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9999"
                            Padding="12,6"
                            Margin="0,14,0,0"
                            HorizontalAlignment="Left"
                            Visibility="{Binding FeaturedSeries, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{StaticResource CyanPrimaryBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SeriesVersionLine}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Logo grande de la serie -->
                <Border Grid.Column="1"
                        Width="132" Height="132"
                        CornerRadius="26"
                        ClipToBounds="True"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource GlassCardBrush}"
                        VerticalAlignment="Center"
                        Margin="24,0,0,0"
                        Effect="{StaticResource ShadowLG}"
                        Visibility="{Binding FeaturedSeries, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Border Background="{StaticResource ThumbFallbackBrush}" />
                        <ContentControl Content="{StaticResource IconLogo}"
                                        Width="48" Height="48"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Opacity="0.7" />
                        <Image Source="{Binding HeroLogo}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= DESTACADA (tarjeta de vidrio) ================= -->
            <Border x:Name="FeaturedPanel"
                    Style="{StaticResource CardGlass}"
                    Margin="0,22,0,0"
                    Padding="0"
                    Visibility="{Binding FeaturedSeries, Converter={StaticResource NullToVisibilityConverter}}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FeaturedSlide" X="0" Y="0" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Arte de la serie -->
                    <Border Grid.Column="0"
                            CornerRadius="14,0,0,14"
                            ClipToBounds="True"
                            MinHeight="190"
                            Background="{StaticResource ThumbFallbackBrush}">
                        <Grid>
                            <ContentControl Content="{StaticResource IconSparkles}"
                                            Width="44" Height="44"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Opacity="0.5" />
                            <Image Source="{Binding FeaturedSeries.Banner}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FeaturedSeries.Banner}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#000B0B0F" Offset="0" />
                                        <GradientStop Color="#660B0B0F" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Info + tags + mini-stats -->
                    <StackPanel Grid.Column="1" Margin="20,16,20,16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource TagPill}"
                                    Background="{StaticResource AccentTintBrush}">
                                <TextBlock Text="SERIE"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentLightBrush}" />
                            </Border>
                            <Border Style="{StaticResource TagPill}"
                                    Background="{StaticResource GlassCardBrush}"
                                    BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding FeaturedSeries.StatusText}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding FeaturedSeries.Name}"
                                   FontFamily="{StaticResource FontFamilyDisplay}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding FeaturedSeries.Description}"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   TextWrapping="Wrap"
                                   MaxHeight="40"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" />

                        <!-- Mini-stats reales -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="MINECRAFT" Style="{StaticResource TextBlock.Caption}" />
                                <TextBlock Text="{Binding FeaturedSeries.Definition.MinecraftVersion}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="LOADER" Style="{StaticResource TextBlock.Caption}" />
                                <TextBlock Text="{Binding FeaturedSeries.Definition.Loader}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="VERSIÓN" Style="{StaticResource TextBlock.Caption}" />
                                <TextBlock Text="{Binding FeaturedSeries.Version, StringFormat=v{0}}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{Binding FeaturedActionText}"
                                    Command="{Binding FeaturedActionCommand}"
                                    IsEnabled="{Binding IsFeaturedBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Style="{StaticResource Button.Primary}"
                                    Padding="28,10" />
                            <StackPanel VerticalAlignment="Center"
                                        Margin="16,0,0,0"
                                        Visibility="{Binding IsFeaturedBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{Binding FeaturedProgress, Mode=OneWay}"
                                             Width="180" Height="8"
                                             Style="{StaticResource ProgressBar.Glow}" />
                                <TextBlock Text="{Binding FeaturedProgressText}"
                                           Style="{StaticResource TextBlock.Caption}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= NOVEDADES (carrusel horizontal) ================= -->
            <Grid x:Name="NewsPanel" Margin="0,24,0,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="NewsSlide" X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NOVEDADES"
                                   Style="{StaticResource TextBlock.Heading}" />
                        <ProgressBar Width="70" Height="6" IsIndeterminate="True"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="14,0,0,0"
                                     Style="{StaticResource ProgressBar.Glow}"
                                     Visibility="{Binding IsLoadingNews, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="ScrollNewsLeft" ToolTip="Anterior"
                                AutomationProperties.Name="Noticias anteriores"
                                Style="{StaticResource Button.Icon}" Padding="8">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                        <Button Click="ScrollNewsRight" ToolTip="Siguiente"
                                AutomationProperties.Name="Noticias siguientes"
                                Style="{StaticResource Button.Icon}" Padding="8" Margin="4,0,0,0">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Estado vacío -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasNews, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="No se pudieron cargar las novedades"
                               Style="{StaticResource TextBlock.Secondary}" />
                    <TextBlock Text="Se reintentará automáticamente"
                               Style="{StaticResource TextBlock.Muted}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Noticia destacada (grande) + resto en carrusel -->
                <StackPanel Grid.Row="1"
                            Visibility="{Binding HasNews, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- La más reciente, destacada y más grande -->
                    <Border Style="{StaticResource CardGlass}"
                            Padding="0"
                            Margin="0,0,0,12"
                            ClipToBounds="True"
                            DataContext="{Binding FeaturedNews}"
                            Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" MinHeight="150" ClipToBounds="True"
                                    Background="{StaticResource ThumbFallbackBrush}"
                                    CornerRadius="14,0,0,14">
                                <Grid>
                                    <ContentControl Content="{StaticResource IconNews}"
                                                    Width="40" Height="40"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.5" />
                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource TagPill}"
                                            Background="{Binding Category, Converter={StaticResource CategoryToBackgroundConverter}}">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" />
                                    </Border>
                                    <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                               Style="{StaticResource TextBlock.Caption}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{StaticResource FontFamilyDisplay}"
                                           FontSize="20" FontWeight="Bold"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource TextBlock.Secondary}"
                                           TextWrapping="Wrap" MaxHeight="40"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Carrusel horizontal -->
                    <ScrollViewer x:Name="NewsScroller"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentNews}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource NewsCarouselCard}">
                                        <StackPanel>
                                            <!-- Thumbnail real o placeholder con degradado + ícono -->
                                            <Border Height="120" ClipToBounds="True"
                                                    CornerRadius="14,14,0,0"
                                                    Background="{StaticResource ThumbFallbackBrush}">
                                                <Grid>
                                                    <ContentControl Content="{StaticResource IconNews}"
                                                                    Width="36" Height="36"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Opacity="0.5" />
                                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.RenderTransform>
                                                            <ScaleTransform x:Name="ThumbZoom" ScaleX="1" ScaleY="1" />
                                                        </Image.RenderTransform>
                                                        <Image.RenderTransformOrigin>0.5,0.5</Image.RenderTransformOrigin>
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                                            Margin="10,10,0,0"
                                                            CornerRadius="9999"
                                                            Padding="9,3"
                                                            Background="{Binding Category, Converter={StaticResource CategoryToBackgroundConverter}}">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="14,12,14,14">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           TextWrapping="Wrap" MaxHeight="42"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource TextBlock.Muted}"
                                                           TextWrapping="Wrap" MaxHeight="36"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                                           Style="{StaticResource TextBlock.Caption}"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbZoom"
                                                                          Storyboard.TargetProperty="ScaleX"
                                                                          To="1.08" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetName="ThumbZoom"
                                                                          Storyboard.TargetProperty="ScaleY"
                                                                          To="1.08" Duration="0:0:0.25" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbZoom"
                                                                          Storyboard.TargetProperty="ScaleX"
                                                                          To="1" Duration="0:0:0.25" />
                                                        <DoubleAnimation Storyboard.TargetName="ThumbZoom"
                                                                          Storyboard.TargetProperty="ScaleY"
                                                                          To="1" Duration="0:0:0.25" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
