<UserControl x:Class="MineMount.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:MineMount.Models"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1080">

    <!-- NOTA: la entrada fade+slide vive en el code-behind para respetar
         el ajuste de animaciones. -->

    <!-- Hero único sobre el fondo (el fondo es protagonista).
         Sin tarjetas, sin cajas: solo etiqueta, título, descripción y estado. -->
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeroPanel"
                    Grid.Row="0"
                    MaxWidth="660"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="HeroSlide" X="0" Y="0" />
            </StackPanel.RenderTransform>

            <!-- Etiqueta pequeña con barra de acento (sin óvalo) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="15"
                        Background="{DynamicResource AccentPrimaryBrush}"
                        CornerRadius="1.5"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding HeroEyebrow}"
                           Style="{StaticResource TextBlock.HeroEyebrow}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Título grande: nombre de la serie, una sola vez -->
            <TextBlock Text="{Binding BannerTitle}"
                       Style="{StaticResource TextBlock.Hero}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <!-- Descripción: máx. 2 líneas -->
            <TextBlock Text="{Binding BannerSubtitle}"
                       FontSize="15"
                       Foreground="White"
                       TextWrapping="Wrap"
                       MaxHeight="50"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,10,0,0"
                       Opacity="0.92">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#CC000000" Opacity="0.85" Direction="270" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Estado: punto de color + texto, sin píldoras -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,14,0,0"
                        Visibility="{Binding FeaturedSeries, Converter={StaticResource NullToVisibilityConverter}}">
                <Ellipse x:Name="StatusDot"
                         Width="9" Height="9"
                         VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FF22D3EE" Opacity="0.8" />
                    </Ellipse.Effect>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource CyanPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FeaturedSeries.Status}" Value="{x:Static models:SeriesStatus.Installed}">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FeaturedSeries.Status}" Value="{x:Static models:SeriesStatus.UpdateAvailable}">
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FeaturedSeries.Status}" Value="{x:Static models:SeriesStatus.MissingFiles}">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding HeroStatusLine}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#CC000000" Opacity="0.85" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Espacio flexible: el fondo respira hasta la barra inferior -->
        <Grid Grid.Row="1" MinHeight="0" />
    </Grid>
</UserControl>
