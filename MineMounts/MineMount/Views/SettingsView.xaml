<UserControl x:Class="MineMount.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="BackgroundThumb" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ThumbBorder"
                                Width="128" Height="72"
                                CornerRadius="10"
                                ClipToBounds="True"
                                BorderBrush="{StaticResource GlassBorderBrush}"
                                BorderThickness="1"
                                Background="{StaticResource ThumbFallbackBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                <Setter TargetName="ThumbBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ThumbBorder" Property="Effect" Value="{StaticResource ShadowGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,16,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="CONFIGURACIÓN"
                   Style="{StaticResource TextBlock.Title}" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="860">

                <!-- Cuenta -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CUENTA"
                                   Style="{StaticResource TextBlock.Heading}"
                                   Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="Email"
                                           Style="{StaticResource TextBlock.Secondary}"
                                           Margin="0,0,0,4" />
                                <TextBox Width="250"
                                         Style="{StaticResource TextBox.Base}"
                                         Text="{Binding Email}"
                                         HorizontalAlignment="Left" />
                                <TextBlock Text="Contraseña"
                                           Style="{StaticResource TextBlock.Secondary}"
                                           Margin="0,12,0,4" />
                                <PasswordBox Width="250"
                                             Style="{StaticResource PasswordBox.Base}"
                                             HorizontalAlignment="Left" />
                                <Button Content="Iniciar Sesión"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding LoginCommand}"
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Grid.Column="0"
                                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding UserName}"
                                           Style="{StaticResource TextBlock.Heading}" />
                                <TextBlock Text="{Binding Email}"
                                           Style="{StaticResource TextBlock.Secondary}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LastLogin, StringFormat='Último acceso: {0:g}'}"
                                           Style="{StaticResource TextBlock.Muted}"
                                           Margin="0,4,0,0" />
                                <Button Content="Cerrar Sesión"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding LogoutCommand}"
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Juego -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="JUEGO"
                                   Style="{StaticResource TextBlock.Heading}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="RAM Asignada (MB)"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   Margin="0,0,0,4" />
                        <Slider Minimum="{Binding MinRAM}"
                                Maximum="{Binding MaxRAM}"
                                Value="{Binding AllocatedRAM}"
                                Style="{StaticResource Slider.Base}"
                                Width="300"
                                HorizontalAlignment="Left"
                                TickFrequency="512"
                                IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding AllocatedRAM, StringFormat='{}{0} MB'}"
                                   Style="{StaticResource TextBlock.Accent}"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,12" />

                        <TextBlock Text="Ruta de Java"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="300"
                                     Style="{StaticResource TextBox.Base}"
                                     Text="{Binding JavaPath}"
                                     VerticalContentAlignment="Center" />
                            <Button Content="..."
                                    Style="{StaticResource Button.Secondary}"
                                    Command="{Binding BrowseJavaPathCommand}"
                                    Margin="8,0,0,0"
                                    Padding="12,8" />
                        </StackPanel>

                        <TextBlock Text="Directorio del Juego"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   Margin="0,12,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="300"
                                     Style="{StaticResource TextBox.Base}"
                                     Text="{Binding GameDirectory}"
                                     VerticalContentAlignment="Center" />
                            <Button Content="..."
                                    Style="{StaticResource Button.Secondary}"
                                    Command="{Binding BrowseGameDirectoryCommand}"
                                    Margin="8,0,0,0"
                                    Padding="12,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Series -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="SERIES"
                                   Style="{StaticResource TextBlock.Heading}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="Carpeta de instalación de series"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   Margin="0,0,0,4" />
                        <TextBox Width="420"
                                 Style="{StaticResource TextBox.Base}"
                                 Text="{Binding SeriesInstallPath}"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Left"
                                 AutomationProperties.Name="Carpeta de instalación de series" />
                        <TextBlock Text="Vacío usa la predeterminada: %APPDATA%\MineMount\Series"
                                   Style="{StaticResource TextBlock.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Fondo -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="FONDO"
                                   Style="{StaticResource TextBlock.Heading}"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="Modo de fondo"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   Margin="0,0,0,4" />
                        <ComboBox Width="260"
                                  Style="{StaticResource ComboBox.Base}"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding BackgroundMode, Mode=TwoWay}"
                                  AutomationProperties.Name="Modo de fondo"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Rotación automática (8 s)" Tag="Auto" />
                            <ComboBoxItem Content="Fondo fijo" Tag="Fijo" />
                            <ComboBoxItem Content="Desactivado (PCs flojas)" Tag="Desactivado" />
                        </ComboBox>
                        <TextBlock Text="Las imágenes vienen incluidas en el launcher: funciona sin internet. Si alguna falla, se usa el color base #0B0B0F."
                                   Style="{StaticResource TextBlock.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <StackPanel Margin="0,14,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundMode}" Value="Fijo">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Elegí el fondo fijo"
                                       Style="{StaticResource TextBlock.Secondary}"
                                       Margin="0,0,0,8" />
                            <ListBox SelectedIndex="{Binding SelectedBackground, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource BackgroundThumb}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Fondo fijo">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBoxItem>
                                    <Image Source="pack://application:,,,/Assets/Backgrounds/bg1.png" Stretch="UniformToFill" />
                                </ListBoxItem>
                                <ListBoxItem>
                                    <Image Source="pack://application:,,,/Assets/Backgrounds/bg2.jpg" Stretch="UniformToFill" />
                                </ListBoxItem>
                                <ListBoxItem>
                                    <Image Source="pack://application:,,,/Assets/Backgrounds/bg3.jpg" Stretch="UniformToFill" />
                                </ListBoxItem>
                                <ListBoxItem>
                                    <Image Source="pack://application:,,,/Assets/Backgrounds/bg4.jpg" Stretch="UniformToFill" />
                                </ListBoxItem>
                                <ListBoxItem>
                                    <Image Source="pack://application:,,,/Assets/Backgrounds/bg5.jpg" Stretch="UniformToFill" />
                                </ListBoxItem>
                                <ListBoxItem>
                                    <Image Source="pack://application:,,,/Assets/Backgrounds/bg6.jpg" Stretch="UniformToFill" />
                                </ListBoxItem>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Apariencia -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="APARIENCIA"
                                   Style="{StaticResource TextBlock.Heading}"
                                   Margin="0,0,0,12" />

                        <CheckBox Content="Habilitar animaciones"
                                  Style="{StaticResource CheckBox.Base}"
                                  IsChecked="{Binding EnableAnimations}"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="Partículas flotantes (polvo morado)"
                                  Style="{StaticResource CheckBox.Base}"
                                  IsChecked="{Binding EnableParticles}"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="Sonido de click en botones"
                                  Style="{StaticResource CheckBox.Base}"
                                  IsChecked="{Binding EnableSounds}"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Tema"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   Margin="0,12,0,4" />
                        <ComboBox Width="150"
                                  Style="{StaticResource ComboBox.Base}"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Theme, Mode=TwoWay}"
                                  AutomationProperties.Name="Tema"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Oscuro" Tag="Dark" />
                            <ComboBoxItem Content="Claro" Tag="Light" />
                        </ComboBox>

                        <TextBlock Text="Idioma"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   Margin="0,12,0,4" />
                        <ComboBox Width="150"
                                  Style="{StaticResource ComboBox.Base}"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding Language, Mode=TwoWay}"
                                  AutomationProperties.Name="Idioma"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="Español" Tag="es-ES" />
                            <ComboBoxItem Content="English" Tag="en-US" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Launcher -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="LAUNCHER"
                                   Style="{StaticResource TextBlock.Heading}"
                                   Margin="0,0,0,12" />

                        <CheckBox Content="Actualizaciones automáticas"
                                  Style="{StaticResource CheckBox.Base}"
                                  IsChecked="{Binding AutoUpdate}"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="Mostrar noticias"
                                  Style="{StaticResource CheckBox.Base}"
                                  IsChecked="{Binding ShowNews}"
                                  Margin="0,0,0,8" />
                    </StackPanel>
                </Border>

                <!-- Perfiles -->
                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="PERFILES"
                                   Style="{StaticResource TextBlock.Heading}"
                                   Margin="0,0,0,12" />
                        <Button Content="Crear Nuevo Perfil"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding CreateProfileCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Acciones -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,8">
                    <Button Content="Restablecer"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding ResetSettingsCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Guardar"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding SaveSettingsCommand}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
