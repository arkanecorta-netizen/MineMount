<Window x:Class="MineMount.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="MineMount"
        Height="620" Width="860"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontFamilyPrimary}">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8"
                      CaptionHeight="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BaseBackgroundBrush}"
            CornerRadius="14"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <!-- Fondo con blur -->
            <Image Source="pack://application:,,,/Assets/Backgrounds/bg3.jpg"
                   Stretch="UniformToFill"
                   Opacity="0.55">
                <Image.Effect>
                    <BlurEffect Radius="18" />
                </Image.Effect>
            </Image>
            <Border Background="{DynamicResource BackgroundScrimBrush}" />
            <Border Background="#B208080C" />

            <Grid Margin="48,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="0" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="{DynamicResource S.Welcome.Title}"
                               FontFamily="{StaticResource FontFamilyDisplay}"
                               FontSize="34" FontWeight="Bold" Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#CC000000" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource S.Welcome.Sub}"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}"
                               FontSize="14" Margin="0,6,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" MinHeight="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Microsoft -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardGlass}"
                            Margin="0,0,10,0" Padding="26" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center">
                            <ContentControl Content="{StaticResource IconUser}"
                                            Width="40" Height="40"
                                            HorizontalAlignment="Left" />
                            <TextBlock Text="{DynamicResource S.Welcome.MS}"
                                       FontFamily="{StaticResource FontFamilyDisplay}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="White" Margin="0,14,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource S.Welcome.MSDesc}"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />

                            <Button Content="{DynamicResource S.Welcome.MSGo}"
                                    Command="{Binding StartMicrosoftCommand}"
                                    Style="{StaticResource Button.Primary}"
                                    Margin="0,20,0,0" HorizontalAlignment="Stretch"
                                    Height="44"
                                    Visibility="{Binding Stage, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}" />

                            <!-- Espera del navegador -->
                            <StackPanel Margin="0,20,0,0"
                                        Visibility="{Binding Stage, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                                <TextBlock Text="{DynamicResource S.Welcome.CodeTitle}"
                                           FontWeight="SemiBold" Foreground="White"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource S.Welcome.Waiting}"
                                           Foreground="{DynamicResource CyanLightBrush}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding IsWaitingMicrosoft, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="{DynamicResource S.Welcome.OpenBrowser}"
                                            Command="{Binding OpenBrowserCommand}"
                                            Style="{StaticResource Button.Secondary}" />
                                    <Button Content="{DynamicResource S.Welcome.Cancel}"
                                            Command="{Binding CancelMicrosoftCommand}"
                                            Style="{StaticResource Button.Icon}"
                                            Margin="8,0,0,0" Padding="14,8" />
                                </StackPanel>
                                <TextBlock Text="{Binding MicrosoftError}"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding MicrosoftError, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Offline -->
                    <Border Grid.Column="1"
                            Style="{StaticResource CardGlass}"
                            Margin="10,0,0,0" Padding="26" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center">
                            <ContentControl Content="{StaticResource IconMinecraft}"
                                            Width="40" Height="40"
                                            HorizontalAlignment="Left" />
                            <TextBlock Text="{DynamicResource S.Welcome.Offline}"
                                       FontFamily="{StaticResource FontFamilyDisplay}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="White" Margin="0,14,0,0" />
                            <TextBlock Text="{DynamicResource S.Welcome.OfflineDesc}"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />

                            <TextBlock Text="{DynamicResource S.Welcome.Name}"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                       Margin="0,18,0,4" />
                            <TextBox Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TextBox.Base}"
                                     MaxLength="16"
                                     AutomationProperties.Name="Nombre de usuario" />
                            <TextBlock Text="{Binding OfflineNameError}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="12" Margin="0,4,0,0"
                                       Visibility="{Binding OfflineNameError, Converter={StaticResource StringToVisibilityConverter}}" />
                            <TextBlock Text="{DynamicResource S.Welcome.NameHint}"
                                       Style="{StaticResource TextBlock.Caption}"
                                       Margin="0,4,0,0" />

                            <Button Content="{DynamicResource S.Welcome.Continue}"
                                    Command="{Binding ContinueOfflineCommand}"
                                    IsEnabled="{Binding IsOfflineNameValid}"
                                    Style="{StaticResource Button.Primary}"
                                    Margin="0,20,0,0" HorizontalAlignment="Stretch"
                                    Height="44" />

                            <TextBlock Text="{DynamicResource S.Welcome.OfflineWarn}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
