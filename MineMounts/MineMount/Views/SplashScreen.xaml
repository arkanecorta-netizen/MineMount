<Window x:Class="MineMount.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MineMount"
        Width="440" Height="300"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontFamilyPrimary}">

    <Border Background="{StaticResource BackgroundSecondaryBrush}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderPrimaryBrush}"
            BorderThickness="1">
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo -->
            <ContentControl Grid.Row="0"
                            Content="{StaticResource IconLogo}"
                            Width="72" Height="72"
                            HorizontalAlignment="Center" />

            <!-- Title -->
            <TextBlock Grid.Row="1"
                       Text="MINEMOUNT"
                       HorizontalAlignment="Center"
                       FontSize="26"
                       FontWeight="Bold"
                       FontFamily="{StaticResource FontFamilyDisplay}"
                       Foreground="White"
                       Margin="0,14,0,0" />

            <!-- Loading label -->
            <TextBlock Grid.Row="2"
                       x:Name="StatusLabel"
                       Text="Cargando..."
                       HorizontalAlignment="Center"
                       Style="{StaticResource TextBlock.Secondary}"
                       Margin="0,10,0,0" />

            <!-- Progress bar -->
            <Grid Grid.Row="4"
                  VerticalAlignment="Bottom">
                <ProgressBar x:Name="ProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="8"
                             Style="{StaticResource ProgressBar.Base}" />
            </Grid>

            <!-- Percent -->
            <Grid Grid.Row="5" Margin="0,8,0,0">
                <TextBlock x:Name="PercentLabel"
                           Text="0 %"
                           HorizontalAlignment="Left"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentLightBrush}" />
                <TextBlock Text="MineMount 1.0.0"
                           HorizontalAlignment="Right"
                           Style="{StaticResource TextBlock.Caption}" />
            </Grid>
        </Grid>
    </Border>
</Window>
