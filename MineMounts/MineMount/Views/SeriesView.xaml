<UserControl x:Class="MineMount.Views.SeriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="SeriesImageFallbackBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF241040" Offset="0" />
            <GradientStop Color="#FF150A26" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="SERIES"
                           Style="{StaticResource TextBlock.Title}" />
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource TextBlock.Muted}"
                           VerticalAlignment="Center"
                           Margin="16,6,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Actualizar series"
                    AutomationProperties.Name="Actualizar series">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                        <Setter Property="Padding" Value="8" />
                    </Style>
                </Button.Style>
                <ContentControl Content="{StaticResource IconRefresh}"
                                Width="18" Height="18"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>

        <!-- Series Cards -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Series}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}"
                                Width="290"
                                Margin="0,0,16,16"
                                Padding="14">
                            <StackPanel>

                                <!-- Image / Banner -->
                                <Border Height="130"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{StaticResource SeriesImageFallbackBrush}"
                                        BorderBrush="{StaticResource BorderPrimaryBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.7">
                                            <ContentControl Content="{StaticResource IconLogo}"
                                                            Width="44" Height="44"
                                                            HorizontalAlignment="Center" />
                                            <TextBlock Text="SERIE"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentLightBrush}" />
                                        </StackPanel>
                                        <Image Source="{Binding Image}"
                                               Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Image}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Name -->
                                <TextBlock Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,0"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Description -->
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource TextBlock.Muted}"
                                           TextWrapping="Wrap"
                                           MaxHeight="40"
                                           Margin="0,6,0,0" />

                                <!-- Status + Version -->
                                <Grid Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="9999"
                                                Padding="9,3"
                                                Background="{StaticResource AccentTintBrush}">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentLightBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                                   Style="{StaticResource TextBlock.Caption}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Actions -->
                                <Grid Margin="0,12,0,0">
                                    <Button Content="ABRIR"
                                            Height="36"
                                            Command="{Binding OpenSeriesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Id}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Padding="14,8"
                                            CornerRadius="9999"
                                            Background="{StaticResource BackgroundTertiaryBrush}"
                                            BorderBrush="{StaticResource BorderSecondaryBrush}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="PRÓXIMAMENTE"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ForegroundMutedBrush}" />
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
