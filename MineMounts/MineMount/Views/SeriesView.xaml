<UserControl x:Class="MineMount.Views.SeriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:MineMount.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="SeriesThumbFallbackBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF241040" Offset="0" />
            <GradientStop Color="#FF150A26" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="SeriesListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="{StaticResource BackgroundTertiaryBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Background="{StaticResource SeriesThumbFallbackBrush}">
                                    <Grid>
                                        <ContentControl Content="{StaticResource IconLogo}"
                                                        Width="20" Height="20"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.6" />
                                        <Image Source="{Binding Logo, RelativeSource={RelativeSource TemplatedParent}}"
                                               Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Logo, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                                   Style="{StaticResource TextBlock.Caption}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AccentTintBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="SERIES"
                           Style="{StaticResource TextBlock.Title}" />
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource TextBlock.Muted}"
                           VerticalAlignment="Center"
                           Margin="16,6,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Actualizar series"
                    AutomationProperties.Name="Actualizar series">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                        <Setter Property="Padding" Value="8" />
                    </Style>
                </Button.Style>
                <ContentControl Content="{StaticResource IconRefresh}"
                                Width="18" Height="18"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>

        <!-- Master-detail -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Lista -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Margin="0,0,12,0"
                    Padding="12">
                <Grid>
                    <ListBox x:Name="SeriesList"
                             ItemsSource="{Binding Series}"
                             SelectedItem="{Binding SelectedSeries, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SeriesListItem}" />

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSeries}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No hay series disponibles"
                                   Style="{StaticResource TextBlock.Secondary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Revisa tu conexión o actualiza el catálogo"
                                   Style="{StaticResource TextBlock.Muted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detalle embebido -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Padding="20">
                <views:SeriesDetailView DataContext="{Binding Detail}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
