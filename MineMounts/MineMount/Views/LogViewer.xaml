<Window x:Class="MineMount.Views.LogViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MineMount"
        Height="560" Width="760"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontFamilyPrimary}">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8"
                      CaptionHeight="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource GlassSidebarBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{DynamicResource S.Log.Title}"
                           FontFamily="{StaticResource FontFamilyDisplay}"
                           FontSize="22" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="SourceBox" Width="130"
                              Style="{StaticResource ComboBox.Base}"
                              SelectionChanged="SourceBox_SelectionChanged" />
                    <Button Content="{DynamicResource S.Log.Refresh}"
                            Click="Refresh_Click"
                            Style="{StaticResource Button.Secondary}"
                            Margin="8,0,0,0" Padding="12,6" />
                    <Button Click="Close_Click"
                            Style="{StaticResource WindowCloseButton}"
                            Width="40" Height="32" Margin="8,0,0,0"
                            ToolTip="{DynamicResource S.Common.Close}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="10"
                    Background="#59000000"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    ClipToBounds="True">
                <ScrollViewer x:Name="LogScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundPrimaryBrush}"
                             FontFamily="{StaticResource FontFamilyMonospace}"
                             FontSize="12" IsReadOnly="True"
                             TextWrapping="NoWrap"
                             Padding="12" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{DynamicResource S.Log.Copy}"
                        Click="Copy_Click"
                        Style="{StaticResource Button.Secondary}" Padding="14,6" />
                <Button Content="{DynamicResource S.Log.OpenFolder}"
                        Click="OpenFolder_Click"
                        Style="{StaticResource Button.Icon}"
                        Margin="8,0,0,0" Padding="14,6" />
                <TextBlock x:Name="PathLabel"
                           Style="{StaticResource TextBlock.Caption}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
